# Served by Cloudflare Workers (Static Assets). Paths are matched against the exported site.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/api/dataset.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
# Open Graph images are exported without a file extension.
/charts/opengraph-image
  Content-Type: image/png
/teams/:id/opengraph-image
  Content-Type: image/png
/matches/:id/opengraph-image
  Content-Type: image/png
