# Template only. Copy to .env.local (ignored by git) and fill in your values.
# NEXT_PUBLIC_* values are inlined into the public JavaScript bundle: never put secrets in them.
# Bot credentials belong in GitHub Actions secrets (or your local .env.local), never in the repository.

# Public site configuration (inlined at build time)
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_AUTHOR_NAME=Your Name
NEXT_PUBLIC_AUTHOR_LINKEDIN=https://www.linkedin.com/in/your-profile
NEXT_PUBLIC_AUTHOR_X=https://x.com/your-handle
NEXT_PUBLIC_REPO_URL=https://github.com/you/rift-graphs
NEXT_PUBLIC_IMPRINT_NAME=
NEXT_PUBLIC_IMPRINT_ADDRESS=
NEXT_PUBLIC_IMPRINT_EMAIL=
# Cloudflare Web Analytics beacon token (cookie-free page views). Leave empty to disable.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Ingest (scripts/ingest.ts)
# LEAGUEPEDIA_TRANSPORT=export        # "export" (Special:CargoExport, default) or "api" (api.php, supports bot login)
# LEAGUEPEDIA_BOT_USER=
# LEAGUEPEDIA_BOT_PASSWORD=
# LEAGUEPEDIA_DELAY_MS=1500
# INGEST_USER_AGENT="rift-graphs-ingest/0.1 (+https://github.com/you/rift-graphs; contact@example.com)"
# INGEST_MAX_STALE_HOURS=6
# LOLESPORTS_API_KEY=                 # public key embedded in lolesports.com; enables provisional series results. Unset = skipped.
